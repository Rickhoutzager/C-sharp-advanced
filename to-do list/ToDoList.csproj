<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Exclude the test project's sources from the main app's compilation -->
  <ItemGroup>
    <Compile Remove="ToDoList.Tests/**/*.cs" />
    <Content Remove="ToDoList.Tests/**/*" />
    <None Remove="ToDoList.Tests/**/*" />
    <EmbeddedResource Remove="ToDoList.Tests/**/*" />
  </ItemGroup>

</Project>